# Supabase projekt SubBau Social Manager (Settings → API).
# Service role klíč sem NEPATŘÍ — appka ho nepoužívá, všechno jde přes přihlášeného uživatele a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Limit velikosti jednoho nahrávaného souboru v MB (výchozí 50 = Free plán Supabase).
# Po přechodu na Pro (a zvýšení limitu bucketu i projektu) jde zvednout, např. 500.
# Vkládá se při buildu — po změně je potřeba nový build.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

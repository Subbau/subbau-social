# Supabase projekt SubBau Social Manager (Settings → API).
# Prohlížečová část appky jede jen přes přihlášeného uživatele a RLS. Jediná výjimka je
# serverová route /api/cron/skupiny (SUPABASE_SECRET_KEY níže, nikdy NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Limit velikosti jednoho nahrávaného souboru v MB (výchozí 50 = Free plán Supabase).
# Po přechodu na Pro (a zvýšení limitu bucketu i projektu) jde zvednout, např. 500.
# Vkládá se při buildu — po změně je potřeba nový build.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ---------- Skupiny: upozornění do telefonu (Web Push) a cron ----------
# VAPID klíče vygenerujte jednou: npx web-push generate-vapid-keys
# Veřejný klíč smí do prohlížeče (NEXT_PUBLIC_), soukromý NIKDY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Jen server (Vercel → Environment Variables), nikdy s prefixem NEXT_PUBLIC_:
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@subbau.cz
# Secret key projektu Supabase (Settings → API Keys, sb_secret_…) — jen pro /api/cron/skupiny.
SUPABASE_SECRET_KEY=
# Sdílené tajemství pro volání /api/cron/skupiny z pg_cron (min. 32 znaků, stejná hodnota
# ve Vaultu jako 'subbau_vercel_cron_secret'). Vygenerovat např.: openssl rand -hex 32
VERCEL_CRON_SECRET=
